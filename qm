SHOT_DIR = os.path.expanduser("~/Pictures/Screenshots")


def _portal_screenshot(interactive, on_done):
    """Ask the portal for a shot; later call on_done(uri_or_None, why).

    Asynchronous by design: the reply arrives as a Response signal on a
    request object, so there is no thread here - the GTK main loop is
    already running and the portal owns the UI meanwhile.
    """
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    try:
        handle = bus.call_sync(
            "org.freedesktop.portal.Desktop",
            "/org/freedesktop/portal/desktop",
            "org.freedesktop.portal.Screenshot", "Screenshot",
            GLib.Variant("(sa{sv})", ("", {
                "interactive": GLib.Variant("b", interactive),
                "modal": GLib.Variant("b", True),
            })),
            GLib.VariantType("(o)"), Gio.DBusCallFlags.NONE,
            10000, None).unpack()[0]
    except GLib.Error as err:
        on_done(None, f"The screenshot portal refused:\n{err.message}")
        return

    sub = {}

    def responded(_c, _s, _p, _i, _sig, params):
        if "id" in sub:
            bus.signal_unsubscribe(sub["id"])
        code, results = params.unpack()
        if code == 1:
            on_done(None, "Cancelled.")
        elif code != 0 or "uri" not in results:
            on_done(None, "The portal returned no image.")
        else:
            on_done(results["uri"], "")

    sub["id"] = bus.signal_subscribe(
        "org.freedesktop.portal.Desktop",
        "org.freedesktop.portal.Request", "Response", handle, None,
        Gio.DBusSignalFlags.NONE, responded)


def _store_shot(uri):
    """Move the portal's file into ~/Pictures/Screenshots under a real name.

    Left alone it drops Screenshot-1.png straight into ~/Pictures, which
    clutters that folder and tells you nothing when you look later.
    """
    src = uri[7:] if uri.startswith("file://") else uri
    src = urllib.parse.unquote(src)
    if not os.path.exists(src):
        return src
    os.makedirs(SHOT_DIR, exist_ok=True)
    stamp = datetime.now().strftime("%Y-%m-%d %H-%M-%S")
    dest = os.path.join(SHOT_DIR, f"Screenshot from {stamp}.png")
    n = 2
    while os.path.exists(dest):
        dest = os.path.join(SHOT_DIR, f"Screenshot from {stamp} ({n}).png")
        n += 1
    try:
        shutil.move(src, dest)
        return dest
    except OSError:
        return src


def copy_image(path):
    """Put the PNG itself on the clipboard, not just its path.

    wl-copy rather than GDK: it keeps the offer alive after this process
    exits, which is what makes the shot pasteable a minute later.
    """
    try:
        with open(path, "rb") as fh:
            subprocess.run(["wl-copy", "--type", "image/png"],
                           stdin=fh, timeout=10)
        return True
    except (OSError, subprocess.SubprocessError):
        return False


class ShotPanel(Panel):
    """Hide the popup, capture, then come back and report.

    Hidden rather than closed: closing the last window ends the process, and
    there would be nothing left to receive the portal's reply.
    """

    def __init__(self, interactive=True):
        self.interactive = interactive
        self.out = ""
        self._menu = None
        self._path = None

    def current_text(self):
        return self.out

    def build(self, menu):
        self._menu = menu
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self._label = Gtk.Label(
            label=("drag a region…" if self.interactive
                   else "capturing…"),
            selectable=True, wrap=True, xalign=0.0,
            halign=Gtk.Align.START, max_width_chars=46)
        box.append(self._label)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self._open = Gtk.Button(label="Open", sensitive=False)
        self._open.connect("clicked", self._open_clicked)
        row.append(self._open)
        self._folder = Gtk.Button(label="Show folder", sensitive=False)
        self._folder.connect(
            "clicked", lambda *_: subprocess.Popen(["xdg-open", SHOT_DIR]))
        row.append(self._folder)
        box.append(row)

        # Out of frame, and flagged busy so losing focus is not mistaken for
        # the person clicking away.
        menu._busy = True
        menu.set_visible(False)
        GLib.timeout_add(250, self._start)   # let the compositor drop it
        return box

    def _start(self):
        _portal_screenshot(self.interactive, self._finished)
        return False

    def _finished(self, uri, why):
        if uri:
            path = _store_shot(uri)
            self._path = self.out = path
            copied = copy_image(path)
            kb = (os.path.getsize(path) // 1024
                  if os.path.exists(path) else 0)
            self._label.set_label(
                f"{os.path.basename(path)}\n{kb:,} kB"
                + ("\n\nimage copied — paste it anywhere"
                   if copied else ""))
            self._open.set_sensitive(True)
            self._folder.set_sensitive(True)
            # Deliberately NOT menu.note_text(path): the clipboard holds the
            # image, and writing the path over it would be a downgrade. The
            # Copy button still yields the path via current_text().
        else:
            self._label.set_label(why)

        menu = self._menu
        if menu is not None:
            menu._busy = False
            menu.set_visible(True)
            menu.present()

    def _open_clicked(self, *_):
        if self._path:
            subprocess.Popen(["xdg-open", self._path])


class SelectAllPanel(Panel):
