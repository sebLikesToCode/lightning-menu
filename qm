def trans_run(*args):
    """translate-shell, with its colour codes turned off at the source.

    By default trans emits bold/underline escapes even when piped, which is
    why the dictionary output arrived full of stray characters.
    """
    return run_out([TRANS, "-no-ansi", *args])


def _need_trans():
    return None if TRANS else (
        "translate-shell is not installed.\n\n"
        "    sudo apt install translate-shell")


# Targets offered in the dropdown. "trans -b -id" reports a bare code, so
# codes are what the panel works in and these names are only for display.
LANGS = [
    ("en", "English"), ("fr", "French"), ("es", "Spanish"),
    ("de", "German"), ("it", "Italian"), ("pt", "Portuguese"),
    ("nl", "Dutch"), ("la", "Latin"), ("ru", "Russian"),
    ("uk", "Ukrainian"), ("pl", "Polish"), ("sv", "Swedish"),
    ("el", "Greek"), ("tr", "Turkish"), ("ar", "Arabic"),
    ("he", "Hebrew"), ("fa", "Persian"), ("hi", "Hindi"),
    ("ja", "Japanese"), ("ko", "Korean"), ("zh-CN", "Chinese"),
    ("vi", "Vietnamese"), ("th", "Thai"), ("id", "Indonesian"),
]
_LANG_NAME = dict(LANGS)
_CODE_RE = re.compile(r"[a-z]{2,3}(?:-[A-Za-z]{2,4})?")


def lang_name(code):
    if not code:
        return ""
    return _LANG_NAME.get(code) or _LANG_NAME.get(code.split("-")[0]) or code


class Panel:
    """An action result that builds its own widget instead of plain text."""

    def build(self, menu):
        raise NotImplementedError

    def current_text(self):
        return ""

    def label_widget(self):
        """The label holding the result, so a partial selection can be read."""
        return getattr(self, "_label", None)


class TranslatePanel(Panel):
    """One action for the whole job: detect, translate, and let it be changed.

    Target defaults to English, or French when the text is already English,
    so the common case needs no interaction. The detected source language
    sits in the corner.

    trans goes over the network and takes about a second, so every call runs
    on a worker thread and comes back to the UI through GLib.idle_add -
    blocking the main loop would freeze the popup mid-translation.
    """

    def __init__(self, source):
        self.source = source
        self.target = None
        self.out = ""
        self._syncing = False
        self._menu = None

    def current_text(self):
        return self.out

    def build(self, menu):
        self._menu = menu
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        self._label = Gtk.Label(
            label="translating\u2026", selectable=True, wrap=True,
            xalign=0.0, halign=Gtk.Align.START, max_width_chars=46)
        box.append(self._label)

        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self._drop = Gtk.DropDown.new_from_strings(
            [name for _, name in LANGS])
        # 24 entries is a lot to scroll. Search needs an expression telling
        # the dropdown which property of its items to match on.
        self._drop.set_expression(
            Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        self._drop.set_enable_search(True)
        self._drop.connect("notify::selected", self._target_changed)
        bar.append(self._drop)
        self._from = Gtk.Label(label="", halign=Gtk.Align.END, hexpand=True)
        self._from.add_css_class("dim-label")
        bar.append(self._from)
        box.append(bar)

        threading.Thread(target=self._first, daemon=True).start()
        return box

    # -- worker side
    def _first(self):
        code = trans_run("-b", "-id", "--", self.source).strip().lower()
        if not _CODE_RE.fullmatch(code):
            code = ""
        target = "fr" if code.startswith("en") else "en"
        text = trans_run("-b", f":{target}", "--", self.source)
        GLib.idle_add(self._first_done, code, target, text)

    def _again(self, code):
        text = trans_run("-b", f":{code}", "--", self.source)
        GLib.idle_add(self._again_done, code, text)

    # -- UI side
    def _first_done(self, code, target, text):
        self.target = target
        self._show(text)
        self._from.set_label(f"from {lang_name(code)}" if code
                             else "language unknown")
        idx = next((i for i, (c, _) in enumerate(LANGS) if c == target), 0)
        self._syncing = True          # do not re-translate on our own change
        self._drop.set_selected(idx)
        self._syncing = False
        return False

    def _again_done(self, code, text):
        if code == self.target:       # ignore a reply we no longer want
            self._show(text)
        return False

    def _show(self, text):
        self.out = text
        self._label.set_label(text)
        if self._menu is not None:
            self._menu.note_text(text)

    def _target_changed(self, *_):
        if self._syncing:
            return
        code = LANGS[self._drop.get_selected()][0]
        if code == self.target:
            return
        self.target = code
        self._label.set_label("translating\u2026")
        threading.Thread(target=self._again, args=(code,),
                         daemon=True).start()


def act_translate(t):
    return _need_trans() or TranslatePanel(t)


# trans -d is rich but repetitive: every synonym list appears twice, once
# under its own sense and again in a trailing aggregate block, and the
# Examples block repeats examples already shown. For a word like "bright"
# that is about ninety lines. This keeps the per-sense detail, which is the
# useful arrangement, and drops the duplicate blocks.
_POS_WORDS = {
    "noun", "verb", "adjective", "adverb", "pronoun", "preposition",
    "conjunction", "interjection", "determiner", "exclamation",
    "abbreviation", "prefix", "suffix", "article", "numeral", "particle",
}
_SYN_CAP = 12       # a full list runs to 35 words and buries everything else
_SENSE_CAP = 10     # "run" has over forty senses; ten is already plenty


def _parse_define(raw):
    """Pull (word, pronunciation, [(pos, senses)], other_forms) out of it."""
    lines = raw.splitlines()
    if not lines or not lines[0].strip():
        return None

    word = lines[0].strip()
    i, pron = 1, ""
    if i < len(lines) and lines[i].strip().startswith("/"):
        pron = lines[i].strip()
        i += 1

    blocks, forms, cur, mode = [], [], None, None
    for ln in lines[i:]:
        if not ln.strip():
            continue
        text = ln.strip()
        if ln[:1] not in (" ", "\t"):          # unindented = a section head
            low = text.lower()
            if low in _POS_WORDS:
                cur = (text, [])
                blocks.append(cur)
                mode = "pos"
            elif low.startswith("see also"):
                mode = "forms"
            else:
                mode = "skip"               # Synonyms / Examples aggregates
            continue
        if mode == "forms":
            forms += [w.strip() for w in text.split(",") if w.strip()]
        elif mode == "pos" and cur is not None:
            low = text.lower()
            if low.startswith(("synonyms:", "antonyms:")) and cur[1]:
                key = "syn" if low.startswith("syn") else "ant"
                cur[1][-1][key] = [w.strip() for w
                                   in text.split(":", 1)[1].split(",")
                                   if w.strip()]
            elif text.startswith("- ") and cur[1]:
                cur[1][-1]["ex"] = text[2:].strip().strip('"')
            else:
                cur[1].append({"def": text, "ex": "", "syn": [], "ant": []})

    if not any(senses for _, senses in blocks) and not forms:
        return None
    return word, pron, blocks, forms


def _render_define(parsed):
    """Lay it out without relying on column alignment.

    The dictionary renders in the UI font, not monospace, so padding cannot
    be trusted to line up. Structure comes from blank lines and headings,
    and long lines are left for the label to wrap.
    """
    word, pron, blocks, forms = parsed
    out = [f"{word}   {pron}".strip(), ""]
    for pos, senses in blocks:
        if not senses:
            continue
        out.append(pos.upper())
        for n, sense in enumerate(senses[:_SENSE_CAP], 1):
            out.append(f"{n}. {sense['def']}")
            if sense["ex"]:
                out.append(f"   \u201c{sense['ex']}\u201d")
            for key, label in (("syn", "synonyms"), ("ant", "antonyms")):
                words = sense.get(key) or []
                if not words:
                    continue
                more = (f"  (+{len(words) - _SYN_CAP} more)"
                        if len(words) > _SYN_CAP else "")
                out.append(f"   {label}: "
                           + ", ".join(words[:_SYN_CAP]) + more)
        if len(senses) > _SENSE_CAP:
            out.append(f"   (+{len(senses) - _SENSE_CAP} more senses)")
        out.append("")
    if forms:
        out.append("other forms: " + ", ".join(forms))
    return "\n".join(out).rstrip()


def act_define(t):
    missing = _need_trans()
    if missing:
        return missing
    raw = trans_run("-d", ":en", "--", t)
    parsed = _parse_define(raw)
    if parsed:
        return _render_define(parsed)

    # No English dictionary entry. For a word in another language trans -d
    # just echoes it back, which is useless - what is actually wanted there
    # is what it means, so translate instead of showing nothing.
    #
    # Deliberately NOT branching on detected language: detection on a single
    # word is unreliable ("maison" comes back as English, "Bonjour" too).
    # Translating and checking whether the text actually changed is a fact
    # rather than a guess, and it also rejects gibberish, which translates
    # to itself.
    meaning = trans_run("-b", ":en", "--", t).strip()
    if meaning and meaning.lower() != t.strip().lower():
        code = trans_run("-b", "-id", "--", t).strip().lower()
        src = lang_name(code) if _CODE_RE.fullmatch(code) else ""
        head = f"{src} \u2192 English" if src else "In English"
        return f"{t}\n\nNo dictionary entry.\n\n{head}:   {meaning}"
    # "Translations of X" is trans telling us it found no entry and fell back
    # to a translation table; there is nothing in it worth showing.
    if "Translations of" not in raw and len(raw.splitlines()) > 3:
        return raw          # unfamiliar layout - better than losing it
    return f"{t}\n\nNo dictionary entry found."


def counts_line(text):
    """chars / words / lines for the footer.

    Shown permanently rather than behind an action: it costs nothing to
    compute and is the sort of thing wanted at a glance, not on request.
    """
    if not text:
        return ""

    def n_of(count, noun):
        return f"{count:,} {noun}" + ("" if count == 1 else "s")

    parts = [n_of(len(text), "character"),
             n_of(len(text.split()), "word"),
             n_of(len(text.splitlines()) or 1, "line")]
    # Only when it means something. A digest of arbitrary text shown
    # permanently would be 64 characters of noise.
    shape = hash_shape(text)
    if shape:
        parts.append(f"looks like {shape}")
    return "   \u00b7   ".join(parts)


