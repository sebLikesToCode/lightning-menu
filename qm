def _int_value(text):
    """An integer from 0x / 0b / 0o / decimal / trailing-h text, or None."""
    t = re.sub(r"[,_\s]", "", text.strip())
    neg = t.startswith("-")
    if neg:
        t = t[1:]
    try:
        if re.fullmatch(r"0[xX][0-9a-fA-F]+", t):
            v = int(t, 16)
        elif re.fullmatch(r"0[bB][01]+", t):
            v = int(t, 2)
        elif re.fullmatch(r"0[oO][0-7]+", t):
            v = int(t, 8)
        elif re.fullmatch(r"[0-9a-fA-F]+[hH]", t):
            v = int(t[:-1], 16)
        elif re.fullmatch(r"\d+", t):
            v = int(t, 10)
        else:
            return None
    except ValueError:
        return None
    return -v if neg else v


def _bits(n):
    """Binary grouped in fours - a 24-bit word is unreadable otherwise."""
    b = format(n, "b")
    b = "0" * ((-len(b)) % 4) + b
    return " ".join(b[i:i + 4] for i in range(0, len(b), 4))


def _table(rows):
    """Label/value pairs in two columns. Needs the monospace font."""
    width = max(len(k) for k, _ in rows)
    return "\n".join(f"{k.ljust(width)}   {v}" for k, v in rows)


def act_bases(t):
    n = _int_value(t)
    if n is None:
        return (f"{t.strip()[:60]}\n\nNot an integer.\n\n"
                "Reads: 1234, 1,234, 0x7E, 0b1011, 0o176, 7Eh")
    sign, m = ("-" if n < 0 else ""), abs(n)
    rows = [("decimal", f"{sign}{m:,}"),
            ("hex", f"{sign}0x{m:X}"),
            ("octal", f"{sign}0o{m:o}"),
            ("binary", f"{sign}{_bits(m)}"),
            ("bit width", f"{m.bit_length()} bits")]
    if 32 <= m <= 126:
        rows.append(("ASCII", repr(chr(m))))
    elif 126 < m <= 0xFFFF:
        rows.append(("unicode", f"U+{m:04X}  {chr(m)!r}"))
    return _table(rows)


def act_json(t):
    raw = t.strip()
    if not raw:
        return "Nothing to format."
    try:
        data, kind = json.loads(raw), "JSON"
    except ValueError as err:
        # Log lines are often a Python repr rather than JSON - single quotes,
        # True, None. literal_eval reads that without executing anything.
        try:
            data, kind = ast.literal_eval(raw), "Python literal"
        except (ValueError, SyntaxError):
            return f"Not valid JSON.\n\n{err}"

    pretty = json.dumps(data, indent=2, ensure_ascii=False)
    compact = json.dumps(data, separators=(",", ":"), ensure_ascii=False)
    # Input that is already laid out probably wants the opposite done to it.
    if raw.count("\n") >= 2 and len(compact) < len(raw):
        head, body = f"{kind}, minified to {len(compact)} chars", compact
    else:
        head, body = f"{kind}, formatted", pretty

    if isinstance(data, dict):
        head += f"   ·   object, {len(data)} keys"
    elif isinstance(data, list):
        head += f"   ·   array, {len(data)} items"
    return f"{head}\n\n{body}"


# Splits on separators AND at camelCase humps, so any input shape works.
_WORD_SPLIT = re.compile(
    r"[^0-9A-Za-z]+|(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])")


def act_case(t):
    words = [w for w in _WORD_SPLIT.split(t.strip()) if w]
    if not words:
        return "Nothing to convert."
    low = [w.lower() for w in words]
    cap = [w.capitalize() for w in low]
    return _table([
        ("camelCase", low[0] + "".join(cap[1:])),
        ("PascalCase", "".join(cap)),
        ("snake_case", "_".join(low)),
        ("SCREAMING", "_".join(low).upper()),
        ("kebab-case", "-".join(low)),
        ("Title Case", " ".join(cap)),
        ("lower", " ".join(low)),
        ("UPPER", " ".join(low).upper()),
    ])


# A spread wide enough to be useful for geography, not just for standups.
WORLD = [
    ("Los Angeles", "America/Los_Angeles"), ("Denver", "America/Denver"),
    ("Chicago", "America/Chicago"), ("New York", "America/New_York"),
    ("São Paulo", "America/Sao_Paulo"), ("London", "Europe/London"),
    ("Paris", "Europe/Paris"), ("Cairo", "Africa/Cairo"),
    ("Moscow", "Europe/Moscow"), ("Dubai", "Asia/Dubai"),
    ("Mumbai", "Asia/Kolkata"), ("Beijing", "Asia/Shanghai"),
    ("Tokyo", "Asia/Tokyo"), ("Sydney", "Australia/Sydney"),
    ("Auckland", "Pacific/Auckland"),
]


def _offset(when):
    secs = int((when.utcoffset() or datetime.now().utcoffset()
                or utc_tz.utc.utcoffset(None)).total_seconds())
    sign = "+" if secs >= 0 else "−"
    hrs, mins = divmod(abs(secs) // 60, 60)
    return f"UTC{sign}{hrs}" + (f":{mins:02d}" if mins else "")


def _relative(when, now):
    secs = (when - now).total_seconds()
    ahead, secs = secs > 0, abs(secs)
    for size, noun in ((31557600, "year"), (2629800, "month"),
                       (604800, "week"), (86400, "day"),
                       (3600, "hour"), (60, "minute")):
        if secs >= size:
            n = int(secs / size)
            unit = noun + ("" if n == 1 else "s")
            return f"in {n} {unit}" if ahead else f"{n} {unit} ago"
    return ""


def _read_time(text):
    """(datetime, how it was read), or (None, "") if nothing time-like."""
    t = text.strip()
    digits = re.sub(r"[,_\s]", "", t)
    if re.fullmatch(r"\d{10}", digits):
        return datetime.fromtimestamp(int(digits), utc_tz.utc), "epoch seconds"
    if re.fullmatch(r"\d{13}", digits):
        return (datetime.fromtimestamp(int(digits) / 1000, utc_tz.utc),
                "epoch milliseconds")
    try:
        d = datetime.fromisoformat(t.replace("Z", "+00:00"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=datetime.now().astimezone().tzinfo)
        return d, "ISO timestamp"
    except ValueError:
        pass
    clock = re.fullmatch(
        r"(\d{1,2})[:h](\d{2})(?::(\d{2}))?\s*(?:([ap])\.?m?\.?)?", t, re.I)
    if clock:
        hour, minute = int(clock.group(1)), int(clock.group(2))
        half = (clock.group(4) or "").lower()
        if half == "p" and hour < 12:
            hour += 12
        elif half == "a" and hour == 12:
            hour = 0
        if 0 <= hour < 24 and 0 <= minute < 60:
            return (datetime.now().astimezone().replace(
                hour=hour, minute=minute, second=int(clock.group(3) or 0),
                microsecond=0), "time of day")
    return None, ""


def act_time(t):
    now = datetime.now().astimezone()
    when, how = _read_time(t)
    if when is None:
        when, how = now, "now  (nothing time-like in the selection)"

    local = when.astimezone(now.tzinfo)
    rows = [("local", f"{local:%a %d %b %Y, %H:%M:%S}   "
                      f"{local:%Z} {_offset(local)}"),
            ("UTC", f"{when.astimezone(utc_tz.utc):%a %d %b %Y, %H:%M:%S}"),
            ("epoch", str(int(when.timestamp())))]
    rel = _relative(when, now)
    if rel:
        rows.append(("", rel))

    out = [how, "", _table(rows), ""]
    width = max(len(n) for n, _ in WORLD)
    for name, zone in WORLD:
        try:
            z = when.astimezone(ZoneInfo(zone))
        except Exception:
            continue
        out.append(f"{name.ljust(width)}   {z:%a %H:%M}   {_offset(z)}")
    return "\n".join(out)


