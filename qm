def _unhandled(path):
    """The file's type, if nothing is registered to open it; else None.

    xdg-open is fire-and-forget, so without this check a file with no
    handler silently does nothing and the menu just closes - which is
    indistinguishable from the action being broken.
    """
    try:
        kind = subprocess.run(["xdg-mime", "query", "filetype", path],
                              capture_output=True, text=True,
                              timeout=5).stdout.strip()
        if not kind:
            return None
        app = subprocess.run(["xdg-mime", "query", "default", kind],
                             capture_output=True, text=True,
                             timeout=5).stdout.strip()
        return None if app else kind
    except (OSError, subprocess.SubprocessError):
        return None


def act_open(t):
    """A local file or folder, or a web address - whichever it actually is.

    The old version prefixed anything without a scheme with https://, so a
    path became https:///home/sebastian/... and opened nothing.
    """
    # Backticks and angle brackets come along when the path was copied out
    # of formatted output.
    raw = t.strip().strip("\"'`<>").strip()
    if raw.startswith("file://"):
        subprocess.Popen(["xdg-open", raw])
        return None

    # A terminal wrapping a long path puts a newline - and sometimes an
    # indent - in the middle of it. Only the newline and the whitespace
    # right after it are removed: a path may legitimately contain a double
    # space, so runs of spaces are left alone.
    tries = [raw]
    if "\n" in raw:
        tries.append(re.sub(r"\n[ \t]*", "", raw))

    looks_local = raw.startswith(("~", "/", "./", "../"))
    for candidate in tries:
        path = os.path.expanduser(candidate)
        if os.path.exists(path):
            orphan = _unhandled(path)
            if orphan:
                return (f"{os.path.basename(path)}\n\n"
                        f"Nothing on this system is registered to open "
                        f"{orphan} files.\n\n"
                        f"The file is fine - there is no viewer installed.")
            subprocess.Popen(["xdg-open", path])
            return None
    if looks_local:
        return f"{raw[:70]}\n\nNo such file or folder."
    path = os.path.expanduser(raw)
    if "://" in raw:
        subprocess.Popen(["xdg-open", raw])
        return None
    if re.fullmatch(r"[\w.-]+\.[A-Za-z]{2,}(?:[/?#].*)?", raw):
        subprocess.Popen(["xdg-open", "https://" + raw])
        return None
    return f"{raw[:60]}\n\nNot a file, folder or web address."


