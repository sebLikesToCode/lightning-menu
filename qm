def _build_aliases():
    out = {}
    for dim, table in _UNITS.items():
        for key in table:
            out[key.lower()] = (dim, key)
    for line in _ALIAS_TABLE.strip().splitlines():
        key, _, names = line.partition(":")
        key = key.strip()
        target = next(((d, k) for d, t in _UNITS.items()
                       for k in t if k == key), None)
        if target is None:
            continue
        for name in names.split():
            out[name.strip().lower()] = target
    return out


_ALIASES = _build_aliases()

# Temperature converts by offset, so it cannot live in the factor table.
_TEMPS = {"c": "C", "celsius": "C", "centigrade": "C", "°c": "C",
          "f": "F", "fahrenheit": "F", "°f": "F",
          "k": "K", "kelvin": "K"}

_CONVERT = re.compile(
    r"^\s*(.+?)\s*(?:\bto\b|\bin\b|\binto\b|\bas\b|->|→)\s*"
    r"([A-Za-z°/0-9µ]+)\s*$", re.I)
_VALUE_UNIT = re.compile(r"(-?[\d.]+(?:[eE][+-]?\d+)?)\s*([A-Za-z°/0-9µ]+)")


def _unit_key(name):
    cleaned = name.strip().lower().replace("²", "2").replace("³", "3")
    cleaned = cleaned.rstrip(".")
    if cleaned in _ALIASES:
        return _ALIASES[cleaned]
    squashed = cleaned.replace(" ", "").replace("-", "")
    return _ALIASES.get(squashed)


def _num(value):
    if value == int(value) and abs(value) < 1e15:
        return f"{int(value):,}"
    text = f"{value:,.6f}".rstrip("0").rstrip(".")
    if text in ("0", "-0"):
        return f"{value:.6g}"
    return text


def _to_temp(value, src, dst):
    kelvin = {"C": value + 273.15,
              "F": (value - 32.0) * 5.0 / 9.0 + 273.15,
              "K": value}[src]
    return {"C": kelvin - 273.15,
            "F": (kelvin - 273.15) * 9.0 / 5.0 + 32.0,
            "K": kelvin}[dst]


def convert_units(text):
    """"5 km to miles", "100 F in C", "3 ft 6 in to cm". None if it is not one."""
    match = _CONVERT.match(text.strip())
    if not match:
        return None
    left, want = match.group(1), match.group(2)

    # temperature first - offsets, not factors
    dst_temp = _TEMPS.get(want.strip().lower())
    pairs = _VALUE_UNIT.findall(left)
    if dst_temp and len(pairs) == 1:
        amount, unit = pairs[0]
        src_temp = _TEMPS.get(unit.strip().lower())
        if src_temp:
            got = _to_temp(float(amount), src_temp, dst_temp)
            def mark(scale):          # kelvin takes no degree sign
                return scale if scale == "K" else "°" + scale
            return "\n".join([
                f"{_num(float(amount))} {mark(src_temp)}"
                f"   →   {mark(dst_temp)}", "",
                f"= {_num(got)} {mark(dst_temp)}"])

    target = _unit_key(want)
    if target is None or not pairs:
        return None
    dim, dst = target

    total = 0.0
    shown = []
    for amount, unit in pairs:
        found = _unit_key(unit)
        if found is None or found[0] != dim:
            return None
        total += float(amount) * _UNITS[dim][found[1]]
        shown.append(f"{_num(float(amount))} {found[1]}")

    answer = total / _UNITS[dim][dst]
    out = [" + ".join(shown) + f"   →   {dst}", "",
           f"= {_num(answer)} {dst}"]

    others = [k for k in _UNITS[dim] if k != dst][:7]
    if others:
        rows = [(k, _num(total / _UNITS[dim][k])) for k in others]
        out += ["", f"same amount in other {dim} units", "", _table(rows)]
    return "\n".join(out)


def act_convert(t):
    done = convert_units(t)
    if done is not None:
        return done
    return ("Not a conversion.\n\n"
            "Write it like:\n"
            "    5 km to miles\n"
            "    100 F in C\n"
            "    3 ft 6 in to cm\n"
            "    70 mph to km/h\n"
            "    2 cups in ml")


# ------------------------------------------------------------------- vectors
#
# [1, 2, 3] · [4, 5, 6] and [1, 0, 0] × [0, 1, 0]. Like matrices this has to
# run before the ordinary pipeline, which rewrites [ as ( and turns both ·
# and × into plain multiplication - at which point the two lists are tuples
# and the parser gives up.

_VEC_LIT = r"[(\[]\s*[^()\[\]]+?\s*[)\]]"
_DOT_PROD = re.compile(rf"^\s*({_VEC_LIT})\s*[·⋅•∙]\s*({_VEC_LIT})\s*$")
_CROSS_PROD = re.compile(rf"^\s*({_VEC_LIT})\s*[×⨯✕]\s*({_VEC_LIT})\s*$")


def _vector_cells(text):
    """Components of a single-level bracketed list, or None.

    Two components minimum, so that "(3) × (4)" stays ordinary scalar
    multiplication rather than being read as a one-dimensional vector.
    """
    cells = [c.strip() for c in text.strip()[1:-1].split(",") if c.strip()]
    return cells if len(cells) >= 2 else None


def vector_calc(text):
    """A dot or cross product. Returns output, or None."""
    body, _ = strip_header(text)
    for pattern, method, title in ((_DOT_PROD, "dot", "dot product"),
                                   (_CROSS_PROD, "cross", "cross product")):
        found = pattern.match(body.strip())
        if not found:
            continue
        left = _vector_cells(found.group(1))
        right = _vector_cells(found.group(2))
        if not left or not right:
            continue
        if len(left) != len(right):
            return (f"{prettify_maths(body.strip())}\n\n"
                    f"Those vectors are different lengths: "
                    f"{len(left)} and {len(right)}.")
        if method == "cross" and len(left) != 3:
            return (f"{prettify_maths(body.strip())}\n\n"
                    f"A cross product needs three components each; "
                    f"these have {len(left)}.")

        import sympy
        from sympy.parsing.sympy_parser import (
            parse_expr, standard_transformations, convert_xor)
        src = (f"Matrix([{', '.join(left)}]).{method}"
               f"(Matrix([{', '.join(right)}]))")
        try:
            value = parse_expr(
                src, transformations=standard_transformations + (convert_xor,),
                local_dict={"Matrix": sympy.Matrix})
        except Exception as err:
            return f"{prettify_maths(body.strip())}\n\nCould not work that out.\n\n{err}"

        pp = _printer()
        out = [title, "", _layout([prettify_maths(body.strip()), value], pp)]
        if method == "dot":
            # The angle between them is the usual next question.
            try:
                a = sympy.Matrix([parse_expr(c) for c in left])
                b = sympy.Matrix([parse_expr(c) for c in right])
                if not (a.free_symbols or b.free_symbols):
                    na, nb = a.norm(), b.norm()
                    if na and nb:
                        angle = sympy.acos(value / (na * nb))
                        out += ["", _table([
                            ("|a|", prettify_maths(str(sympy.N(na, 8)))),
                            ("|b|", prettify_maths(str(sympy.N(nb, 8)))),
                            ("angle", f"{sympy.N(sympy.deg(angle), 6)}°"),
                        ])]
            except Exception:
                pass
        return "\n".join(out)
    return None


# ------------------------------------------------------------------ matrices
#
# ((1, 2), (3, 4)) and [[1, 2], [3, 4]] both read as a matrix. This has to
# run before the ordinary pipeline, which turns [ into ( and treats commas
# as separating equations - either of which destroys a matrix.

_MAT_NESTED = re.compile(r"[(\[]\s*[(\[]")
_MAT_LITERAL = re.compile(r"[(\[]\s*(?:[(\[][^()\[\]]*[)\]]\s*,?\s*)+[)\]]")
_MAT_VERBS = {
    "det": "({m}).det()", "determinant": "({m}).det()",
    "inv": "({m})**-1", "inverse": "({m})**-1",
    "transpose": "({m}).T", "rank": "({m}).rank()",
    "trace": "({m}).trace()", "rref": "({m}).rref()[0]",
    "eigenvalues": "({m}).eigenvals()", "eigenvals": "({m}).eigenvals()",
    "eigenvectors": "({m}).eigenvects()",
    "nullspace": "({m}).nullspace()", "norm": "({m}).norm()",
}


def _matrix_source(text):
    """Rewrite each matrix literal as Matrix([[...], [...]])."""
    def one(found):
        rows = re.findall(r"[(\[]([^()\[\]]*)[)\]]", found.group(0))
        cells = [[c.strip() for c in row.split(",") if c.strip()]
                 for row in rows]
        if not cells or not all(cells):
            return found.group(0)
        if len({len(row) for row in cells}) != 1:
            return found.group(0)      # ragged rows: not a matrix
        inner = ", ".join("[" + ", ".join(row) + "]" for row in cells)
        return f"Matrix([{inner}])"
    return _MAT_LITERAL.sub(one, text)


def _matrix_summary(mat, pp, sympy):
    """What is worth knowing about a matrix you just typed."""
    rows, cols = mat.shape
    out = [f"{rows} × {cols} matrix", ""]
    lines, _ = _block(mat, pp)
    out += lines
    facts = []
    if rows == cols:
        det = mat.det()
        facts.append(("det", prettify_maths(str(det))))
        facts.append(("trace", prettify_maths(str(mat.trace()))))
        facts.append(("rank", str(mat.rank())))
        out += ["", _table(facts)]
        if det != 0:
            out += ["", "inverse"]
            inv_lines, _ = _block(mat.inv(), pp)
            out += inv_lines
        else:
            out += ["", "singular — no inverse (det = 0)"]
    else:
        facts.append(("rank", str(mat.rank())))
        out += ["", _table(facts)]
    return "\n".join(out)


def matrix_calc(text):
    """Anything holding a matrix literal. Returns output, or None."""
    if not _MAT_NESTED.search(text):
        return None
    import sympy
    from sympy.parsing.sympy_parser import (
        parse_expr, standard_transformations, convert_xor)

    body, _ = strip_header(text)
    body = body.strip()

    shape = None
    bars = re.fullmatch(r"\|\s*(.+?)\s*\|", body, re.S)
    if bars:
        body, shape = bars.group(1), "({m}).det()"
    else:
        verb = re.match(r"^([A-Za-z]+)\s*(?=[(\[])", body)
        if verb and verb.group(1).lower() in _MAT_VERBS:
            shape = _MAT_VERBS[verb.group(1).lower()]
            body = body[verb.end():]

    src = _matrix_source(normalise_maths(body))
    if "Matrix(" not in src:
        return None
    # "bare" means the selection was nothing but a matrix - then a summary
    # is what is wanted. M^-1 or A*B is an operation, and should show its
    # answer instead.
    bare = shape is None and re.fullmatch(r"Matrix\(\[.*\]\)",
                                          src.strip(), re.S) is not None
    if shape:
        src = shape.format(m=src)

    # No implicit multiplication here: its split_symbols step would try to
    # read "Matrix" as M*a*t*r*i*x.
    names = {"Matrix": sympy.Matrix, "eye": sympy.eye, "zeros": sympy.zeros,
             "ones": sympy.ones, "diag": sympy.diag}
    try:
        value = parse_expr(src, transformations=standard_transformations
                           + (convert_xor,), local_dict=names)
    except Exception as err:
        return (f"{prettify_maths(text.strip()[:70])}\n\n"
                f"Could not read that as a matrix.\n\n{err}")

    pp = _printer()
    echo = prettify_maths(text.strip())

    try:
        if isinstance(value, sympy.MatrixBase):
            if bare:
                return _matrix_summary(value, pp, sympy)
            return _layout([echo, value], pp)
        if isinstance(value, dict):          # eigenvalues
            rows = [(prettify_maths(str(k)),
                     f"multiplicity {v}") for k, v in value.items()]
            return "\n".join([echo, "", "eigenvalues", "", _table(rows)])
        if isinstance(value, (list, tuple)):
            out = [echo, ""]
            for item in value:
                if isinstance(item, tuple):   # eigenvects: (val, mult, vecs)
                    out.append(f"λ = {prettify_maths(str(item[0]))}"
                               f"   (multiplicity {item[1]})")
                    for vec in item[2]:
                        out += _block(vec, pp)[0]
                    out.append("")
                else:
                    out += _block(item, pp)[0] + [""]
            return "\n".join(out).rstrip()
        return _layout([echo, value], pp)
    except Exception as err:
        return f"{echo}\n\nCould not finish that.\n\n{err}"


# Symbols with a real mathematical meaning that nothing here implements.
# Left alone they became variables and the answer came out confidently
# wrong, which is worse than refusing.
_NOT_YET = {
    "∬": "double integrals", "∭": "triple integrals",
    "∮": "contour integrals", "∇": "the gradient operator ∇",
    "∈": "set membership", "∉": "set membership", "∋": "set membership",
    "⊂": "subsets", "⊆": "subsets", "⊃": "supersets", "⊇": "supersets",
    "∪": "unions", "∩": "intersections", "∖": "set difference",
    "∅": "the empty set", "∀": "'for all'", "∃": "'there exists'",
    "∧": "logical and", "∨": "logical or", "¬": "logical not",
    "⇒": "implication", "⇔": "equivalence", "∴": "'therefore'",
    "∵": "'because'", "∠": "angles", "⊥": "perpendicularity",
    "∥": "parallel lines", "≅": "congruence", "∝": "proportionality",
    "⊕": "direct sums", "⊗": "tensor products",
}


def unsupported_symbols(text):
    names = []
    for symbol, name in _NOT_YET.items():
        if symbol in text and name not in names:
            names.append(name)
    return names


def act_calc(text):
    if len(text) > MAX_INPUT:
        return "Selection is too long to be an expression."
    missing = unsupported_symbols(text)
    if missing:
        return (f"{text.strip()[:70]}\n\nI cannot do "
                + ", ".join(missing) + " yet.\n\n"
                "Rather than treat those symbols as variables and hand you "
                "a confident wrong answer, this stops here.")

    # "5 km to miles" typed into Calculate should just work.
    converted = convert_units(text)
    if converted is not None:
        return converted

    as_vector = vector_calc(text)
    if as_vector is not None:
        return as_vector

    # Matrices next: the ordinary pipeline would rewrite their brackets
    # and split them on their commas.
    as_matrix = matrix_calc(text)
    if as_matrix is not None:
        return as_matrix

    if "±" in text or "∓" in text:
        def branch(sign_plus):
            swapped = (text.replace("±", "+").replace("∓", "-")
                       if sign_plus else
                       text.replace("±", "-").replace("∓", "+"))
            return "\n".join("   " + ln
                             for ln in act_calc(swapped).splitlines())
        return "\n".join([prettify_maths(text.strip()), "",
                          "taking  +", branch(True), "",
                          "taking  −", branch(False)])

    stripped, target = strip_header(text)
    body, subs_raw = split_subs(stripped)
    norm = normalise_maths(body)
    if not norm:
        return "Nothing to calculate."
    try:
        return _sympy_calc(norm, subs_raw, target)
    except ImportError:
        pass
    except Exception as e:
        return f"{prettify_maths(norm)}\n\nCould not evaluate:\n{e}"
    try:
        val = _ast_calc(ast.parse(norm, mode="eval").body)
    except Exception as e:
        return (f"{prettify_maths(norm)}\n\nCould not evaluate: {e}\n\n"
                "Variables and algebra need sympy:\n"
                "    sudo apt install python3-sympy")
    return prettify_maths(f"{norm}\n\n= {val}")


