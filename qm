_CATEGORY = {
    "Lu": "letter, uppercase", "Ll": "letter, lowercase",
    "Lt": "letter, titlecase", "Lm": "letter, modifier",
    "Lo": "letter, other", "Mn": "mark, non-spacing",
    "Mc": "mark, spacing combining", "Me": "mark, enclosing",
    "Nd": "number, decimal digit", "Nl": "number, letter",
    "No": "number, other", "Pc": "punctuation, connector",
    "Pd": "punctuation, dash", "Ps": "punctuation, open",
    "Pe": "punctuation, close", "Pi": "punctuation, initial quote",
    "Pf": "punctuation, final quote", "Po": "punctuation, other",
    "Sm": "symbol, math", "Sc": "symbol, currency",
    "Sk": "symbol, modifier", "So": "symbol, other",
    "Zs": "separator, space", "Zl": "separator, line",
    "Zp": "separator, paragraph", "Cc": "control", "Cf": "format",
    "Cs": "surrogate", "Co": "private use", "Cn": "unassigned",
}
_CHAR_CAP = 32


def _char_name(ch):
    try:
        return unicodedata.name(ch)
    except ValueError:
        return "<unnamed>"


def _entity(cp):
    named = html_entities.codepoint2name.get(cp)
    numeric = f"&#{cp};"
    return f"&{named};   or   {numeric}" if named else numeric


def _printable(ch):
    """A safe stand-in for characters that would wreck the layout."""
    return " " if unicodedata.category(ch)[0] in ("C", "Z") else ch


def act_chars(t):
    if not t:
        return "Nothing selected."

    # One character is the usual case - "what IS this thing?" - and deserves
    # the full picture. Several get a compact row each instead.
    if len(t) == 1:
        ch = t
        cp = ord(ch)
        cat = unicodedata.category(ch)
        rows = [("character", _printable(ch) or "(not printable)"),
                ("codepoint", f"U+{cp:04X}"),
                ("name", _char_name(ch)),
                ("category", f"{cat}   {_CATEGORY.get(cat, '')}".rstrip()),
                ("HTML", _entity(cp)),
                ("decimal", str(cp)),
                ("UTF-8", " ".join(f"{b:02x}" for b in ch.encode())),
                ("UTF-16", " ".join(f"{b:02x}" for b
                                    in ch.encode("utf-16-be")))]
        if unicodedata.decomposition(ch):
            rows.append(("decomposes", unicodedata.decomposition(ch)))
        if unicodedata.combining(ch):
            rows.append(("combining", str(unicodedata.combining(ch))))
        return _table(rows)

    shown = t[:_CHAR_CAP]
    out = [f"{len(t):,} characters   ·   "
           f"{len(t.encode()):,} bytes UTF-8", ""]
    for ch in shown:
        cp = ord(ch)
        name = _char_name(ch)
        out.append(f"{_printable(ch)}  U+{cp:04X}  {name[:34]}")
    if len(t) > _CHAR_CAP:
        out.append(f"… and {len(t) - _CHAR_CAP:,} more")

    # Text that looks identical but is not: a composed e-acute versus an e
    # followed by a combining accent. Worth saying, because it is exactly
    # the kind of thing that makes a string comparison fail.
    nfc = unicodedata.normalize("NFC", t)
    if nfc != t:
        out += ["", f"not NFC-normalised — NFC form is "
                    f"{len(nfc):,} characters"]
    return "\n".join(out)


# Lengths are the only clue a bare hex string gives about its algorithm.
_HASH_SHAPES = {8: "CRC32", 32: "MD5", 40: "SHA-1", 56: "SHA-224",
                64: "SHA-256", 96: "SHA-384", 128: "SHA-512"}
_HASH_FUNCS = {32: hashlib.md5, 40: hashlib.sha1, 56: hashlib.sha224,
               64: hashlib.sha256, 96: hashlib.sha384, 128: hashlib.sha512}

# How every checksum file in the world is laid out: digest, space, filename.
# The star marks binary mode in md5sum/sha256sum output.
_CHECKSUM_LINE = re.compile(r"^\s*([0-9a-fA-F]{8,128})\s+\*?(\S.*?)\s*$")


def hash_shape(text):
    """Which algorithm a bare hex string is the right length to be."""
    t = text.strip()
    if 8 <= len(t) <= 128 and re.fullmatch(r"[0-9a-fA-F]+", t):
        return _HASH_SHAPES.get(len(t))
    return None


def _find_file(name):
    """Resolve a filename from a checksum line.

    Downloads are where this is nearly always pointed, and a checksum line
    carries a bare filename with no directory, so that is worth trying.
    """
    for candidate in (name, os.path.expanduser(name),
                      os.path.expanduser(f"~/Downloads/{name}"),
                      os.path.expanduser(f"~/Desktop/{name}")):
        if os.path.isfile(candidate):
            return candidate
    return None


def _digest_file(path, func):
    h = func()
    try:
        with open(path, "rb") as fh:
            while True:
                chunk = fh.read(1 << 20)     # streamed: files get large
                if not chunk:
                    break
                h.update(chunk)
    except OSError as err:
        return None, str(err)
    return h.hexdigest(), None


def _verify(expected, name):
    """Hash the named file and say whether it matches the given digest."""
    func = _HASH_FUNCS.get(len(expected))
    algo = _HASH_SHAPES.get(len(expected), "unknown")
    if func is None:
        return f"{expected}\n\nNo algorithm produces a {len(expected)}-character digest."
    path = _find_file(name)
    if path is None:
        return (f"{name}\n\nCannot find that file.\n\n"
                f"Looked beside it, in ~/Downloads and ~/Desktop.\n"
                f"Highlight the full path instead and I will hash it.")
    actual, err = _digest_file(path, func)
    if err:
        return f"Could not read {path}.\n\n{err}"
    ok = actual.lower() == expected.lower()
    return "\n".join([
        os.path.basename(path),
        f"{os.path.getsize(path):,} bytes   ·   {algo}",
        "",
        "✓  MATCHES" if ok else "✗  DOES NOT MATCH",
        "",
        "expected", expected.lower(),
        "",
        "actual", actual,
    ])


def _hash_rows(data):
    rows = [("md5", hashlib.md5(data).hexdigest()),
            ("sha1", hashlib.sha1(data).hexdigest()),
            ("crc32", f"{zlib.crc32(data) & 0xFFFFFFFF:08x}")]
    long_rows = [("sha256", hashlib.sha256(data).hexdigest()),
                 ("sha512", hashlib.sha512(data).hexdigest())]
    return rows, long_rows


def _hash_layout(head, short_rows, long_rows):
    # The long digests go on their own line: at 64 and 128 characters they
    # will not sit beside a label without wrapping into the column.
    out = [head, "", _table(short_rows)]
    for name, digest in long_rows:
        out += ["", name, digest]
    return "\n".join(out)


def act_hash(t):
    raw = t.strip().strip("\"'")

    # A checksum line - "<digest>  <filename>" - is the download-validation
    # case, and the only one where a hash can actually be checked rather
    # than just computed. Try it before anything else.
    line = _CHECKSUM_LINE.match(t.strip())
    if line and not os.path.isfile(os.path.expanduser(raw)):
        return _verify(line.group(1), line.group(2))

    shape = hash_shape(raw)
    if shape and not os.path.exists(os.path.expanduser(raw)):
        return (f"{raw}\n\n{len(raw)} hex characters — the right "
                f"length for {shape}.\n\n"
                "To check a file against it, highlight the whole checksum "
                "line:\n\n    " + raw[:16] + "…  filename.iso")

    path = os.path.expanduser(raw)
    # A path means hash the file, which is the actually useful case -
    # checking a download against a published checksum.
    if raw and os.path.isfile(path):
        md5, sha1, sha256, sha512 = (hashlib.md5(), hashlib.sha1(),
                                     hashlib.sha256(), hashlib.sha512())
        crc = 0
        try:
            with open(path, "rb") as fh:
                while True:
                    chunk = fh.read(1 << 20)   # streamed: files get large
                    if not chunk:
                        break
                    for h in (md5, sha1, sha256, sha512):
                        h.update(chunk)
                    crc = zlib.crc32(chunk, crc)
        except OSError as err:
            return f"Could not read the file.\n\n{err}"
        size = os.path.getsize(path)
        return _hash_layout(
            f"{os.path.basename(path)}\n{size:,} bytes",
            [("md5", md5.hexdigest()), ("sha1", sha1.hexdigest()),
             ("crc32", f"{crc & 0xFFFFFFFF:08x}")],
            [("sha256", sha256.hexdigest()),
             ("sha512", sha512.hexdigest())])

    if not t:
        return "Nothing to hash."
    data = t.encode("utf-8")
    short_rows, long_rows = _hash_rows(data)
    return _hash_layout(f"text   ·   {len(data):,} bytes UTF-8",
                        short_rows, long_rows)


