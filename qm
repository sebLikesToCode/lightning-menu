# ----------------------------------------------------------------- selection
def selection():
    """The PRIMARY selection - whatever is highlighted right now.

    Falls back to the clipboard so the menu stays useful when nothing is
    highlighted but something was copied.
    """
    for args in (["wl-paste", "--primary", "-n"], ["wl-paste", "-n"]):
        try:
            r = subprocess.run(args, capture_output=True, text=True, timeout=3)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    return ""


LOG = os.path.join(os.environ.get(
    "XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "qm.log")


def note(line):
    """One line per launch about window placement, for when it misbehaves.

    Placement depends on things no error message would reveal - which GDK
    backend we got, whether xdotool can see the window - so each attempt
    records what it found.
    """
    try:
        with open(LOG, "a") as fh:
            fh.write(f"{datetime.now():%Y-%m-%d %H:%M:%S}  {line}\n")
    except OSError:
        pass


def _on_x11():
    """True when we are an X11 client (i.e. running under XWayland)."""
    try:
        # The class is "X11Display" here, not "GdkX11Display" - checking for
        # the prefix silently never matched, so the window never moved.
        return "X11" in type(Gdk.Display.get_default()).__name__
    except Exception:
        return False


PLACE_FILE = os.path.join(os.environ.get(
    "XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "qm-place")


def shell_place_at_pointer(title, gap=14):
    """Ask the qmplace shell extension to put this window at the pointer.

    The compositor is the only place where this is possible at all: a client
    may not position its own surface on Wayland, and cannot learn where the
    pointer is outside its own windows. Inside the shell both are ordinary -
    global.get_pointer() is the live position and Mutter can move any
    window. So the extension does the whole job and we just ask.

    True when placed; False when the extension answered but could not find
    the window yet (so retrying is worth it); None when the extension is not
    loaded at all, which is the case until the next login after installing
    it (so retrying is not).
    """
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        placed, = bus.call_sync(
            "org.gnome.Shell", "/org/gnome/Shell/Extensions/QmPlace",
            "org.gnome.Shell.Extensions.QmPlace", "PlaceAtPointer",
            GLib.Variant("(si)", (title, gap)),
            GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, 2000,
            None).unpack()
        return bool(placed)
    except GLib.Error:
        return None        # not loaded at all, as opposed to "not yet"


def saved_place():
    """Where this window was last dragged to, or None."""
    try:
        with open(PLACE_FILE) as fh:
            x, y = fh.read().split()
            return int(x), int(y)
    except (OSError, ValueError):
        return None


def remember_place(x, y):
    try:
        with open(PLACE_FILE, "w") as fh:
            fh.write(f"{x} {y}")
    except OSError:
        pass


def pointer_xy():
    """DO NOT USE for placement - the answer is stale.

    Kept only as a record of why. On native Wayland no client can ask where
    the pointer is outside its own surfaces. XWayland does answer, but only
    with the last position an X11 client saw: with Wayland-native apps under
    the pointer it never updates, and returns the same coordinates for
    hours. Placing a window there puts it in a fixed arbitrary spot.
    """
    if not XDOTOOL:
        return None
    try:
        got = subprocess.run([XDOTOOL, "getmouselocation", "--shell"],
                             capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return None
    if got.returncode != 0:
        return None
    seen = {}
    for line in got.stdout.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            seen[key] = value
    try:
        return int(seen["X"]), int(seen["Y"])
    except (KeyError, ValueError):
        return None


def clipboard_text():
    """The clipboard only, never the primary selection."""
    try:
        got = subprocess.run(["wl-paste", "-n"], capture_output=True,
                             text=True, timeout=3)
        if got.returncode == 0:
            return got.stdout
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def copy(text):
    try:
        subprocess.run(["wl-copy"], input=text, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        pass


def set_clipboard(text):
    """Set the clipboard from inside this process.

    Deliberately NOT wl-copy. On GNOME a client has to own a focused surface
    to take the clipboard, so wl-copy briefly steals focus - and this menu
    dismisses itself on focus loss, so the answer was being thrown away the
    instant it appeared. Measured both ways: with the wl-copy call the window
    dies on click, without it the window survives.
    """
    try:
        Gdk.Display.get_default().get_clipboard().set(text)
    except Exception:
        pass


def notify(body, summary="qm"):
    try:
        subprocess.Popen(["notify-send", "-a", "qm", summary, body])
    except OSError:
        pass


# SGR escape codes. A GtkLabel has no idea what these mean and renders them
# as stray characters, so nothing that reaches the UI may contain them.
_ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def run_out(args):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return "(timed out)"
    except OSError as e:
        return f"(could not run {args[0]}: {e})"
    text = (r.stdout or "").strip() or (r.stderr or "").strip()
    return _ANSI.sub("", text) or "(no output)"


# ==================================================================== maths
#
# Text copied off a worksheet or a website is full of typography that no
# parser accepts: real x and ÷ signs, superscript exponents, a U+2212 minus
# that merely looks like a hyphen, vulgar fractions, thousands separators.
# Everything below rewrites that into ordinary ASCII before parsing.

_SUP_DIGITS = "⁰¹²³⁴⁵⁶⁷⁸⁹"
_SUP_OTHER = "⁺⁻⁼⁽⁾ⁿⁱ"
_SUP_MAP = str.maketrans(_SUP_DIGITS + _SUP_OTHER, "0123456789+-=()ni")
_SUP_RUN = re.compile(f"[{_SUP_DIGITS}{_SUP_OTHER}]+")

_SUB_MAP = str.maketrans(
    "₀₁₂₃₄₅₆₇₈₉",
    "0123456789")
_SUB_RUN = re.compile("[₀-₉]+")

_VULGAR = {
    "½": "(1/2)", "⅓": "(1/3)", "⅔": "(2/3)",
    "¼": "(1/4)", "¾": "(3/4)", "⅕": "(1/5)",
    "⅖": "(2/5)", "⅗": "(3/5)", "⅘": "(4/5)",
    "⅙": "(1/6)", "⅚": "(5/6)", "⅐": "(1/7)",
    "⅛": "(1/8)", "⅜": "(3/8)", "⅝": "(5/8)",
    "⅞": "(7/8)", "⅑": "(1/9)", "⅒": "(1/10)",
}

_SYMBOL = {
    "×": "*", "⋅": "*", "·": "*", "∗": "*",
    "✕": "*", "✖": "*", "⁢": "*",
    "÷": "/", "∕": "/", "⁄": "/", "／": "/", "∶": "/",
    "−": "-", "–": "-", "—": "-", "‐": "-", "‑": "-",
    "＋": "+", "﹢": "+",
    "π": "pi", "ℯ": "E", "∞": "oo", "∂": "d",
    "°": "*pi/180", "º": "*pi/180",     # so trig on degrees works
    "≤": "<=", "≥": ">=", "≠": "!=",
    "≈": "=", "≡": "=", "＝": "=",
    "‘": "", "’": "", "“": "", "”": "",
    " ": " ", " ": " ", " ": " ", "​": "",
    "（": "(", "）": ")", "[": "(", "]": ")", "{": "(", "}": ")",
}

# A root sign binds to the token after it, so it needs explicit brackets:
# "sqrt9" would otherwise parse as sqrt*9 once implicit multiplication is on.
_ROOT_INDEX = {"√": 2, "∛": 3, "∜": 4}
_ROOT = re.compile(r"([√∛∜])\s*"
                   r"(\d+(?:\.\d+)?|[A-Za-z]\w*|\([^()]*\))")

# Thousands separators, but only between digit groups - never a comma that
# is separating arguments.
_FLOOR = re.compile(r"⌊([^⌊⌋]*)⌋")
_CEIL = re.compile(r"⌈([^⌈⌉]*)⌉")
_ABS_BARS = re.compile(r"\|([^|]+)\|")
# Digits only, and never a bare "C": "0 C to K" is a temperature, not a
# binomial coefficient.
_CHOOSE = re.compile(r"\b(\d+)\s*(?:choose|nCr)\s*(\d+)\b", re.I)
_THOUSANDS = re.compile(r"(?<=\d),(?=\d{3}(?!\d))")

# "800 x 222" is multiplication; "2x + 1" and "x + 1" are the variable x.
# The difference is whether a NUMBER sits on both sides, so that is the test.
_X_AS_TIMES = re.compile(r"(?<=[\d)])\s*[xX✕]\s*(?=[\d(])")

_PERCENT_OF = re.compile(r"(\d+(?:\.\d+)?)\s*%\s*of\s+", re.I)
_TRAILING_PCT = re.compile(r"(\d+(?:\.\d+)?)\s*%")


# ∫ x² dx, ∫_0^1 x² dx, d/dx x², ∂/∂x, ∑_(n=1)^10 n² - the symbols people
# actually write, rewritten into the calls sympy understands.
_LIMITS_WORDS = re.compile(r"\bfrom\s+(\S+)\s+to\s+(\S+)\s*$", re.I)
_INTEGRAL = re.compile(
    r"∫\s*(?:_\s*\{?([^\s^{}]+)\}?\s*\^\s*\{?([^\s{}]+)\}?\s*)?"
    r"(.+?)\s*d\s*([A-Za-z]\w*)\s*$", re.S)
_DERIVATIVE = re.compile(r"\bd\s*/\s*d\s*([A-Za-z]\w*)\s*(.+)$", re.S)
_LIMIT = re.compile(
    r"\blim\s*_?\s*\(?\s*([A-Za-z]\w*)\s*(?:→|->|to)\s*([^\s)]+)\s*\)?\s*"
    r"(.+)$", re.S | re.I)
_PRODUCT = re.compile(
    r"∏\s*_?\s*\(?\s*([A-Za-z]\w*)\s*=\s*([^\s)^]+)\s*\)?\s*"
    r"\^\s*\(?\s*([^\s)]+)\s*\)?\s*(.+)$", re.S)
_SUMMATION = re.compile(
    r"[∑Σ]\s*_?\s*\(?\s*([A-Za-z]\w*)\s*=\s*([^\s)^]+)\s*\)?\s*"
    r"\^\s*\(?\s*([^\s)]+)\s*\)?\s*(.+)$", re.S)


def _calculus(text):
    """Rewrite calculus notation as integrate() / diff() / summation()."""
    body = text
    worded = None
    found = _LIMITS_WORDS.search(body)
    if found:
        worded = (found.group(1), found.group(2))
        body = body[:found.start()].rstrip()

    hit = _INTEGRAL.search(body)
    if hit:
        lower, upper, inner, var = hit.groups()
        if worded and not lower:
            lower, upper = worded
        inner = inner.strip() or "1"
        if lower and upper:
            tail = f"integrate({inner}, ({var}, {lower}, {upper}))"
        else:
            tail = f"integrate({inner}, {var})"
        return body[:hit.start()] + tail

    hit = _LIMIT.search(body)
    if hit:
        var, point, inner = hit.groups()
        return body[:hit.start()] + f"limit({inner.strip()}, {var}, {point})"

    hit = _PRODUCT.search(body)
    if hit:
        var, low, high, inner = hit.groups()
        return (body[:hit.start()]
                + f"product({inner.strip()}, ({var}, {low}, {high}))")

    hit = _SUMMATION.search(body)
    if hit:
        var, low, high, inner = hit.groups()
        return (body[:hit.start()]
                + f"summation({inner.strip()}, ({var}, {low}, {high}))")

    hit = _DERIVATIVE.search(body)
    if hit:
        var, inner = hit.groups()
        return body[:hit.start()] + f"diff({inner.strip()}, {var})"

    return text


def normalise_maths(src):
    """Rewrite typographic maths into something a parser accepts."""
    s = src.strip()

    for k, v in _VULGAR.items():
        s = s.replace(k, v)

    # Do not add brackets the input already has: "√(-9)" would otherwise
    # become sqrt((-9)) and echo back with doubled parentheses.
    # Reading ∛ as √ gave 2.83 for the cube root of 8 - a wrong answer with
    # no warning at all, which is the worst way for this to fail.
    def _root(found):
        index = _ROOT_INDEX[found.group(1)]
        arg = found.group(2)
        if not arg.startswith("("):
            arg = "(" + arg + ")"
        return f"sqrt{arg}" if index == 2 else f"root{arg[:-1]}, {index})"
    s = _ROOT.sub(_root, s)
    s = _SUP_RUN.sub(lambda m: "**(" + m.group(0).translate(_SUP_MAP) + ")", s)
    # x₁ must become x_1, not x1: the parser reads a trailing digit as
    # multiplication, so "x₁ + x₂" was collapsing to 3*x.
    s = _SUB_RUN.sub(lambda m: "_" + m.group(0).translate(_SUB_MAP), s)

    for k, v in _SYMBOL.items():
        s = s.replace(k, v)

    s = _FLOOR.sub(r"floor(\1)", s)
    s = _CEIL.sub(r"ceiling(\1)", s)
    s = _ABS_BARS.sub(r"Abs(\1)", s)
    s = _CHOOSE.sub(r"binomial(\1, \2)", s)
    s = _THOUSANDS.sub("", s)
    s = _PERCENT_OF.sub(r"(\1/100)*", s)
    s = _TRAILING_PCT.sub(r"(\1/100)", s)
    s = _X_AS_TIMES.sub("*", s)
    s = s.rstrip("=").strip()
    s = re.sub(r"\s+", " ", s)
    # Last, so the integrand is already plain ASCII by this point.
    return _calculus(s)


# ------------------------------------------------- output, in real notation
#
# normalise_maths() goes the other way: typography in, ASCII out, so a parser
# can read it. This turns the parser's output back into notation a person
# reads - superscript powers, implicit multiplication, real signs, and a
# horizontal bar for fractions.

_SUPER_OUT = str.maketrans("0123456789-+()",
                           "⁰¹²³⁴⁵"
                           "⁶⁷⁸⁹"
                           "⁻⁺⁽⁾")

_BAR = "─"          # the box-drawing rule sympy uses for fraction bars
# Pictures worth keeping in two dimensions: a fraction bar, or the bracket
# pieces sympy builds matrices out of.
_KEEP_2D = (_BAR, "⎡", "⎣", "⎢", "⎤", "⎦", "⎥")


def prettify_maths(text):
    """8*x**2 - 8*x*y  ->  8x² − 8xy  (single line)"""
    out = text

    # Integer powers become superscripts; anything else falls back to ^,
    # since there are no superscript glyphs for arbitrary expressions.
    out = re.sub(r"\*\*\(?(-?\d+)\)?",
                 lambda m: m.group(1).translate(_SUPER_OUT), out)
    out = re.sub(r"\^\(?(-?\d+)\)?",
                 lambda m: m.group(1).translate(_SUPER_OUT), out)
    out = out.replace("**", "^")

    out = re.sub(r"\bsqrt\((\d+(?:\.\d+)?)\)(?!\s*\*)",
                 lambda m: "√" + m.group(1), out)
    out = out.replace("sqrt(", "√(")
    out = re.sub(r"\bpi\b", "π", out)
    out = re.sub(r"\boo\b", "∞", out)
    # sympy writes the imaginary unit as I. Nobody reads it that way, and a
    # variable named I is impossible anyway - the parser claims that letter.
    out = re.sub(r"\bI\b", "i", out)

    # Tighten the spacing first, so "8 * x" and "8*x" are handled alike and
    # removing the sign cannot leave a double space behind.
    out = re.sub(r"[ \t]*\*[ \t]*", "*", out)
    out = re.sub(r"(?<=\d)\*(?=\d)", " × ", out)
    out = re.sub(r"(?<=[\d)])\*(?=\()", " × ", out)
    out = re.sub(r"(?<=\))\*(?=\w)", " × ", out)
    # A name beside a number needs the sign too: "π2" would not read as
    # a product, while "8x" does.
    out = re.sub(r"(?<=[^\W\d_])\*(?=[\d(])", " × ", out)
    out = out.replace("*", "")

    out = re.sub(r"[ \t]*/[ \t]*", " ÷ ", out)
    out = out.replace(">=", "≥").replace("<=", "≤")
    out = out.replace("!=", "≠")

    # A real minus sign, not a hyphen. Safe wholesale: by this point every
    # hyphen left in the string is arithmetic.
    return out.replace("-", "−")


def _exact_enough(value):
    """True when a decimal approximation would add nothing.

    An integer or a Gaussian integer - 3, -i, 2+3i - already reads exactly,
    and "≈ -1.0i" printed beside "-i" is noise. Fractions and radicals do
    benefit from one.
    """
    try:
        real, imag = value.as_real_imag()
    except Exception:
        return False
    return bool(real.is_Integer and imag.is_Integer)


def _printer():
    from sympy.printing.pretty.pretty import PrettyPrinter
    return PrettyPrinter({"use_unicode": True, "wrap_line": False})


def _block(obj, pp):
    """(lines, baseline) for a sympy expression or an already-pretty string.

    Expressions that contain a real fraction keep sympy's two-dimensional
    layout, so the bar is drawn horizontally with numerator above and
    denominator below. Everything else collapses to one line, because
    stacking a whole expression to show "x squared" would be worse than
    writing x².

    Only same-width substitutions are allowed on the 2-D art: changing any
    line's length would break the column alignment that holds the stack
    together.
    """
    if isinstance(obj, str):
        return ([obj], 0)
    # sympy prints small rationals inline ("5/2") and only stacks big ones.
    # A fraction is precisely where a bar belongs, so draw it either way.
    if getattr(obj, "is_Rational", False) and not obj.is_Integer:
        num, den = str(abs(obj.p)), str(obj.q)
        width = max(len(num), len(den))
        rows = [num.center(width), _BAR * width, den.center(width)]
        if obj.p < 0:
            rows = [" " + rows[0], "\u2212" + rows[1], " " + rows[2]]
        return (rows, 1)
    try:
        form = pp._print(obj)
        pic = [str(ln) for ln in form.picture]
    except Exception:
        return ([prettify_maths(str(obj))], 0)
    if any(any(mark in ln for mark in _KEEP_2D) for ln in pic):
        return ([re.sub(r"\bI\b", "i", ln).replace("-", "−")
                 for ln in pic], form.baseline)
    return ([prettify_maths(str(obj))], 0)


def _layout(items, pp):
    """Stack steps with the = signs in one column, on each step's baseline.

    A multi-line step puts its = beside the fraction bar rather than beside
    the numerator, which is where the eye expects it.
    """
    blocks, last = [], None
    for it in items:
        lines, base = _block(it, pp)
        key = "\n".join(lines)
        if key == last or not key.strip():
            continue
        last = key
        blocks.append((lines, base))

    out = []
    for i, (lines, base) in enumerate(blocks):
        lead = "  " if i == 0 else "= "
        for j, ln in enumerate(lines):
            out.append(((lead if j == base else "  ") + ln).rstrip())
    return "\n".join(out)


def _labelled(label, obj, pp):
    """A label with a possibly-stacked value under it."""
    lines, base = _block(obj, pp)
    if len(lines) == 1:
        return [f"{label} {lines[0].strip()}"]
    pad = " " * (len(label) + 1)
    return [((label + " ") if i == base else pad) + ln.rstrip()
            for i, ln in enumerate(lines)]


def _fmt(val):
    """Trim sympy's zero padding: 24.0000000000 -> 24, 0.500000 -> 0.5."""
    t = str(val)
    if "." in t and "e" not in t.lower() and "E" not in t:
        t = t.rstrip("0").rstrip(".")
    return t or "0"


# A trailing clause can supply values for the variables:
#   "8x^2 + (-8xy) with x = -1 and y = 900"
#   "3a + 2b, a=4, b=5"
# Selections copied off a worksheet carry an instruction with them:
#   "1. solve a + b + c"    "find x: 2x + 4 = 10"    "simplify 3a + 2a"
# None of that is maths, and the parser choked on every one of them.
_LIST_PREFIX = re.compile(
    r"^\s*(?:(?:q|question|ex|exercise|problem|part|no|number)\s*)?"
    r"(?:\(?[0-9]{1,3}\)?[.):]\s*|\(?[a-z]\)?[.)]\s*)+", re.I)
_VERBS = (r"solve|find|evaluate|simplify|expand|factor|factorise|factorize|"
          r"calculate|compute|determine|work\s+out|what\s+is|whats")
# "find the value of x:", "solve for y", "work out the answer:" - the
# filler between the verb and the maths varies, so allow for it.
_VERB_HEAD = re.compile(
    r"^\s*(?:" + _VERBS + r")\b"
    r"(?:\s+(?:the\s+)?(?:value|values|root|roots|solution|solutions|"
    r"answer|result)s?)?"
    r"(?:\s+(?:of|to))?"
    r"(?:\s+for\s+([A-Za-z]\w*))?"
    r"\s*[:,]?\s*", re.I)
_TARGET_COLON = re.compile(r"^\s*([A-Za-z]\w*)\s*:\s*")


def strip_header(text):
    """Strip any instruction wrapper. Returns (maths, the named unknown).

    A word counts as the unknown only when it is explicit - after "for", or
    followed by a colon. Otherwise "solve a + b + c" would lose its a.
    """
    body = _LIST_PREFIX.sub("", text, count=1)
    # A list marker must not swallow a real term. "(3) × (4)" looks exactly
    # like the "(a)" of a numbered question, and stripping it left "× (4)" -
    # which starts with an operator, and that is the giveaway.
    if body.strip()[:1] in {"+", "-", "*", "/", "^", "×", "÷", "·", "−", ")"}:
        body = text
    target = None
    head = _VERB_HEAD.match(body)
    if head:
        target = head.group(1)
        body = body[head.end():]
    if target is None:
        named = _TARGET_COLON.match(body)
        if named and body[named.end():].strip():
            target, body = named.group(1), body[named.end():]
    return body.strip(), target


def split_equations(norm):
    """Several equations in one selection: "2x + y = 7, x - y = 2"."""
    chunks = [c.strip() for c in re.split(r"[;,]|\band\b", norm, flags=re.I)]
    chunks = [c for c in chunks if c]
    if len(chunks) >= 2 and all(c.count("=") == 1 for c in chunks):
        return chunks
    return None


_SUBS_KEYWORD = re.compile(r"\b(?:with|where|given|when|for|at)\b", re.I)
_ASSIGN_TAIL = re.compile(r"\s*[A-Za-z]\w*\s*=[^=].*", re.S)


def split_subs(src):
    """Separate 'expression' from 'values for its variables'."""
    m = _SUBS_KEYWORD.search(src)
    if m:
        return src[:m.start()], src[m.end():]
    # No keyword: peel assignments off the end. Thousands separators are
    # safe here, because "250" does not match name=value.
    parts = src.split(",")
    tail = []
    while len(parts) > 1 and _ASSIGN_TAIL.fullmatch(parts[-1]):
        tail.insert(0, parts.pop())
    # Only if the remainder is an expression. "x + y + z = 6, x - y = 0,
    # z = 2" is three equations, not an expression with z supplied, and
    # peeling the last one off left unparseable wreckage.
    if tail and "=" not in ",".join(parts):
        return ",".join(parts), ",".join(tail)
    return src, ""


def parse_subs(clause):
    """{'x': '-1', 'y': '900'} from 'x = -1 and y = 900'."""
    out = {}
    for part in re.split(r",|;|\band\b", clause, flags=re.I):
        name, _, val = part.strip().partition("=")
        name, val = name.strip(), val.strip()
        if val and re.fullmatch(r"[A-Za-z]\w*", name):
            out[name] = val
    return out


# ---- engine 1: sympy, when it is installed. Variables, exact fractions,
# ---- solving, substitution, simplification.
def _sympy_calc(norm, subs_raw="", target=None):
    import sympy
    from sympy.parsing.sympy_parser import (
        parse_expr, standard_transformations,
        implicit_multiplication_application, convert_xor)

    tr = standard_transformations + (
        implicit_multiplication_application, convert_xor)
    pp = _printer()

    def parse(t, evaluate=True):
        return parse_expr(t, transformations=tr, evaluate=evaluate)

    subs_txt = parse_subs(subs_raw) if subs_raw else {}

    # ---- values supplied: simplify, plug in, show the working
    if subs_txt:
        expr = parse(norm)
        simple = sympy.expand(expr)
        env = {sympy.Symbol(k): parse(normalise_maths(v))
               for k, v in subs_txt.items()}

        steps = [expr, simple]

        # The "plug in" line is textual on purpose: substituting for real
        # evaluates immediately, so there would be nothing left to show.
        plugged = str(simple)
        for name, val in subs_txt.items():
            plugged = re.sub(rf"\b{re.escape(name)}\b", f"({val})", plugged)
        steps.append(prettify_maths(plugged))

        # One intermediate line: each top-level term worked out on its own.
        # Substituting into the whole Add would collapse straight to the
        # answer, so each arg is substituted separately.
        if simple.is_Add and len(simple.args) > 1:
            bits = []
            for arg in simple.args:
                v = arg.subs(env, simultaneous=True)
                t = _fmt(v) if not getattr(v, "is_Integer", False) else str(v)
                if not bits:
                    bits.append(t)
                elif t.startswith("-"):
                    bits.append("- " + t[1:])
                else:
                    bits.append("+ " + t)
            steps.append(prettify_maths(" ".join(bits)))

        final = sympy.expand(simple.subs(env, simultaneous=True))
        if final.free_symbols or getattr(final, "is_Integer", False):
            steps.append(final)
        else:
            steps.append(prettify_maths(_fmt(sympy.N(final, 12))))

        given = ",   ".join(f"{k} = {prettify_maths(v)}"
                            for k, v in subs_txt.items())
        out = [given, "", _layout(steps, pp)]
        if not final.free_symbols and not getattr(final, "is_Integer", False):
            out += [""] + _labelled("exact:", final, pp)
        left = sorted(str(x) for x in final.free_symbols)
        if left:
            out += ["", "still unknown: " + ", ".join(left)]
        return "\n".join(out)

    # ---- an inequality, which must be caught before the solve branch:
    # "3 <= 4" contains an "=" and was being split on it into nonsense.
    if re.search(r"<=|>=|<|>", norm):
        expr = parse(norm)
        out = [prettify_maths(norm), ""]
        if not getattr(expr, "free_symbols", set()):
            out.append("true" if bool(expr) else "false")
            return "\n".join(out)
        try:
            out.append(prettify_maths(str(sympy.reduce_inequalities(expr))))
        except Exception as err:
            out.append(f"Could not reduce that inequality.\n\n{err}")
        return "\n".join(out)

    # ---- an "=" and no supplied values means solve
    if "=" in norm and "==" not in norm:
        # Several equations at once: "2x + y = 7, x - y = 2". Previously the
        # whole string was split on the first "=" and the rest became
        # nonsense.
        system = split_equations(norm)
        if system:
            eqs = []
            for chunk in system:
                left, _, right = chunk.partition("=")
                eqs.append(sympy.Eq(parse(left), parse(right)))
            syms = sorted(set().union(*(e.free_symbols for e in eqs)),
                          key=lambda z: z.name)
            out = [prettify_maths(",   ".join(system)), ""]
            if not syms:
                out.append("true" if all(bool(e) for e in eqs) else "false")
                return "\n".join(out)
            answers = sympy.solve(eqs, syms, dict=True)
            if not answers:
                out.append("no solution")
            for n, answer in enumerate(answers, 1):
                if len(answers) > 1:
                    out.append(f"solution {n}")
                for z in syms:
                    if z in answer:
                        out += _labelled(f"{z} =", answer[z], pp)
                loose = [z.name for z in syms if z not in answer]
                if loose:
                    out.append("free to choose: " + ", ".join(loose))
            out += ["", f"{len(eqs)} equations, {len(syms)} unknowns"]
            return "\n".join(out)

        lhs, _, rhs = norm.partition("=")
        eq = sympy.Eq(parse(lhs), parse(rhs))
        syms = sorted(eq.free_symbols, key=lambda z: z.name)
        out = [prettify_maths(norm), ""]
        if not syms:
            out.append("true" if bool(eq) else "false")
            return "\n".join(out)
        # "solve for y" names the unknown; otherwise take the first.
        unknown = next((z for z in syms if z.name == target), syms[0])
        sols = sympy.solve(eq, unknown, dict=False)
        if not sols:
            out.append("no solution")
        for sol in sols:
            label = f"{unknown} ="
            out += _labelled(label, sol, pp)
            if not sol.free_symbols and not _exact_enough(sol):
                approx = _fmt(sympy.N(sol, 10))
                if approx != str(sol):
                    # Indent to the value column so it sits under the
                    # fraction rather than floating off to one side.
                    out.append(" " * (len(label) + 1)
                               + f"≈ {prettify_maths(approx)}")
        others = [z.name for z in syms if z is not unknown]
        if others:
            out += ["", f"solved for {unknown.name}; other unknowns: "
                        + ", ".join(others)]
        return "\n".join(out)

    expr = parse(norm)

    # ---- symbolic
    if expr.free_symbols:
        simple = sympy.expand(expr)
        out = [_layout([prettify_maths(norm), simple], pp), ""]
        factored = sympy.factor(simple)
        if factored != simple:
            out += _labelled("factored:", factored, pp)
        out += ["variables: " + ", ".join(sorted(str(x)
                                                 for x in expr.free_symbols)),
                "", "tip: add  with x = 2  to put numbers in"]
        return "\n".join(out)

    # ---- plain number
    if expr.is_Integer or _exact_enough(expr):
        return _layout([prettify_maths(norm), expr], pp)
    approx = _fmt(sympy.N(expr, 12))
    out = [_layout([prettify_maths(norm), prettify_maths(approx)], pp)]
    if str(expr) != approx:
        out += [""] + _labelled("exact:", expr, pp)
    return "\n".join(out)


# ---- engine 2: no sympy. Arithmetic only, via the AST, because eval() on a
# ---- selection would execute whatever happened to be highlighted.
_OPS = {
    ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
    ast.Div: operator.truediv, ast.Pow: operator.pow, ast.Mod: operator.mod,
    ast.FloorDiv: operator.floordiv, ast.USub: operator.neg,
    ast.UAdd: operator.pos,
}


def _ast_calc(node):
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in _OPS:
        return _OPS[type(node.op)](_ast_calc(node.left), _ast_calc(node.right))
    if isinstance(node, ast.UnaryOp) and type(node.op) in _OPS:
        return _OPS[type(node.op)](_ast_calc(node.operand))
    raise ValueError("only numbers and + - * / // % ** are supported")


