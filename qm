class Menu(Gtk.ApplicationWindow):
    def __init__(self, app, text):
        super().__init__(application=app, title=QM_TITLE)
        self.text = text
        self._result_row = None
        # Deliberately narrow. max-width-chars below is a wrap limit,
        # not a minimum, so the window stays this slim for the menu and
        # widens only when a result genuinely needs the room.
        self.set_default_size(380, -1)
        self.set_resizable(False)
        self.set_decorated(False)          # no titlebar
        self.add_css_class("qm-panel")

        # Dismiss on focus loss, like a context menu.
        #
        # _seen_focus guards the obvious bug: a just-presented window reports
        # inactive for a moment before the compositor focuses it, and acting
        # on that first False would close the menu as it opened. Only a loss
        # that FOLLOWS having had focus counts.
        self._seen_focus = False
        self._done = False
        self._busy = False
        self._last_result = None
        self._result_label = None
        self._get_text = None
        self.connect("notify::is-active", self._active_changed)
        # A GDK clipboard offer dies with the process, so hand the answer to
        # wl-copy on the way out. Focus no longer matters once we are closing.
        self.connect("destroy", self._persist_clipboard)
        self.connect("close-request", lambda *_: (self._save_place(),
                                                  False)[1])

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)

        preview = text.replace("\n", " ")
        if len(preview) > 52:
            preview = preview[:51] + "…"
        head = Gtk.Label(
            label=f"“{preview}”" if preview
            else "nothing highlighted — Screenshot and Select all "
                 "still work",
            halign=Gtk.Align.START, wrap=True, max_width_chars=40,
            margin_top=10, margin_bottom=8, margin_start=12, margin_end=12)
        head.add_css_class("dim-label")
        head.add_css_class("qm-head")

        # With no titlebar there is nothing to grab, so the header text is the
        # drag handle. A WindowHandle forwards a press-and-drag on its child
        # to the compositor as a window move.
        self.head = head
        handle = Gtk.WindowHandle()
        handle.set_child(head)
        root.append(handle)

        self.filter = Gtk.SearchEntry(
            placeholder_text="Filter…",
            margin_start=8, margin_end=8, margin_bottom=6)
        self.filter.connect("search-changed",
                            lambda *_: self.list.invalidate_filter())
        self.filter.connect("activate", self._activate_first)
        root.append(self.filter)

        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.list.set_filter_func(self._matches)
        self.list.connect("row-activated", self._chosen)
        # One flat list, in ACTIONS order. A split by "does it read the
        # selection" looked tidy but was wrong: Times reads an epoch or an
        # ISO stamp out of the selection and only falls back to now, so
        # almost everything belongs on the same side of any such line.
        for label, fn in ACTIONS:
            row = Gtk.ListBoxRow()
            row.fn, row.label_text = fn, label
            row.is_result = False
            row.set_child(Gtk.Label(
                label=label, halign=Gtk.Align.START, margin_top=8,
                margin_bottom=8, margin_start=12, margin_end=12))
            self.list.append(row)

        scroll = Gtk.ScrolledWindow(
            propagate_natural_height=True, max_content_height=620,
            hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(self.list)
        root.append(scroll)

        line = counts_line(text)
        if line:
            footer = Gtk.Label(
                label=line, selectable=True, halign=Gtk.Align.START,
                margin_top=6, margin_bottom=10,
                margin_start=12, margin_end=12)
            footer.add_css_class("dim-label")
            footer.add_css_class("qm-head")
            root.append(footer)
            self.footer = footer

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._key)
        self.add_controller(keys)

        # Once mapped, hop to the pointer if we are in a position to.
        # Retried: at the first attempt the window may not be mapped in X
        # yet, and its height is not final either - and the height decides
        # whether the menu goes above or below the pointer.
        self._place_tries = 0
        self.connect("map",
                     lambda *_: GLib.timeout_add(40, self._place_at_pointer))

    # -- behaviour
    def _active_changed(self, *_):
        if self.is_active():
            self._seen_focus = True
            return
        if self._done or not self._seen_focus:
            return
        # Do not dismiss on the first sign of lost focus. Notifications and
        # clipboard helpers can take it for a moment without the user having
        # clicked anywhere, and dismissing then discards the result. Re-check
        # shortly and only close if focus really went elsewhere.
        GLib.timeout_add(350, self._dismiss_if_really_gone)

    def _dismiss_if_really_gone(self):
        if not self._done and not self._busy and not self.is_active():
            self.close()
        return False

    def _save_place(self, *_):
        """Record where the window ended up, so it reopens there.

        Read back from X rather than tracked internally, because the person
        moves it by dragging the header and the application is never told.
        """
        if not (XDOTOOL and _on_x11()):
            return
        try:
            found = subprocess.run([XDOTOOL, "search", "--name", QM_TITLE],
                                   capture_output=True, text=True, timeout=3)
            ids = found.stdout.split()
            if not ids:
                return
            geo = subprocess.run(
                [XDOTOOL, "getwindowgeometry", "--shell", ids[-1]],
                capture_output=True, text=True, timeout=3).stdout
            spot = {}
            for line in geo.splitlines():
                if "=" in line:
                    key, value = line.split("=", 1)
                    spot[key] = value
            remember_place(int(spot["X"]), int(spot["Y"]))
        except (OSError, subprocess.SubprocessError, ValueError, KeyError):
            pass

    def _persist_clipboard(self, *_):
        if self._last_result:
            copy(self._last_result)

    def _key(self, _c, keyval, _code, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if (keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter)
                and state & Gdk.ModifierType.CONTROL_MASK):
            self.replace_selection(self._pick_text())
            return True
        return False

    # ------------------------------------------------------ paste in place
    def _pick_text(self):
        """What Copy and Replace act on.

        If part of the result is highlighted, that part; otherwise all of
        it. This is what makes the multi-row outputs usable - with Change
        case or Bases you highlight the one line you want and replace with
        exactly that.
        """
        label = self._result_label
        if label is not None:
            try:
                found, start, end = label.get_selection_bounds()
            except Exception:
                found = False
            if found and end > start:
                return label.get_text()[start:end]
        return self._get_text() if self._get_text else ""

    def replace_selection(self, text):
        """Paste over whatever is still highlighted in the other application.

        A paste, not backspace-and-retype. Reading the PRIMARY selection
        does not clear it, so the original text is still selected over
        there and Ctrl+V overwrites exactly that span - no guessing how
        many characters to delete, and it works the same in a text editor,
        a browser field or a terminal.
        """
        if not text:
            return
        if not YDOTOOL:
            self._note("ydotool is not installed, so there is nothing that "
                       "can type into another window.\n\n"
                       "    sudo apt install ydotool")
            return
        # wl-copy, not GDK: the paste lands after this process has gone, so
        # the clipboard offer has to outlive it.
        copy(text)
        self._done = True           # hiding must not read as a dismissal
        self.set_visible(False)
        GLib.timeout_add(320, self._send_paste)

    def _send_keys(self, *codes):
        """Press a chord and release it. Returns None, or why it failed."""
        env = dict(os.environ)
        env.setdefault("YDOTOOL_SOCKET", YDOTOOL_SOCKET)
        seq = ([f"{c}:1" for c in codes]
               + [f"{c}:0" for c in reversed(codes)])
        try:
            done = subprocess.run([YDOTOOL, "key", *seq], timeout=8,
                                  capture_output=True, text=True, env=env)
        except (OSError, subprocess.SubprocessError) as err:
            return str(err)
        if done.returncode != 0:
            return ((done.stderr or done.stdout or "").strip()
                    or f"ydotool exited {done.returncode}")
        return None

    def _send_paste(self):
        trouble = self._send_keys(_K_CTRL, _K_V)
        if trouble:
            # Come back and say so rather than vanish having done nothing.
            self._done = False
            self.set_visible(True)
            self.present()
            self._note(f"Could not paste.\n\n{trouble}\n\n"
                       "The text is on your clipboard either way, so "
                       "Ctrl+V still works.")
            return False
        GLib.timeout_add(120, self._after_paste)
        return False

    def _after_paste(self):
        self.close()
        return False

    def _place_at_pointer(self):
        """Move this window to the pointer, where that is possible at all.

        GTK4 removed window positioning outright, and Wayland forbids a
        client from placing its own surface - so this goes out through
        xdotool, which can only see the window while we are an X11 client.
        Launch with GDK_BACKEND=x11 and it lands at the pointer; launch
        natively and it stays centred, which is Wayland working as designed
        rather than a fault.
        """
        self._place_tries += 1
        first = self._place_tries == 1

        # The real answer: the shell extension knows where the pointer is.
        placed = shell_place_at_pointer(QM_TITLE)
        if placed:
            note(f"placed at the pointer by the extension "
                 f"(try {self._place_tries})")
            return False

        # It answered but has not seen the window yet - worth another look.
        if placed is False and self._place_tries < 4:
            GLib.timeout_add(120, self._place_at_pointer)
            return False

        # Extension absent - fall back to wherever it was last dragged,
        # which needs X11 because that route goes through xdotool.
        if not (XDOTOOL and _on_x11()):
            note("no placement: the qmplace extension is not loaded "
                 "(log out and back in) and this is not an X11 client")
            return False
        where = saved_place()
        if where is None:
            note("extension not loaded; no saved position either - "
                 "drag the window and it will reopen there")
            return False
        try:
            found = subprocess.run([XDOTOOL, "search", "--name", QM_TITLE],
                                   capture_output=True, text=True, timeout=3)
            ids = found.stdout.split()
            if not ids:
                if self._place_tries < 4:
                    GLib.timeout_add(120, self._place_at_pointer)
                else:
                    note("no placement: xdotool never found the window")
                return False
            wid = ids[-1]
            geo = subprocess.run(
                [XDOTOOL, "getwindowgeometry", "--shell", wid],
                capture_output=True, text=True, timeout=3).stdout
            size = {}
            for line in geo.splitlines():
                if "=" in line:
                    key, value = line.split("=", 1)
                    size[key] = value
            x, y = where
            subprocess.run([XDOTOOL, "windowmove", wid, str(x), str(y)],
                           timeout=3, capture_output=True)
            note(f"restored to {x},{y} "
                 f"(window {size.get('WIDTH')}x{size.get('HEIGHT')}, "
                 f"try {self._place_tries})")
        except (OSError, subprocess.SubprocessError, ValueError) as err:
            note(f"placement failed: {err}")
        return False

    def _note(self, message):
        if self._result_label is not None:
            self._result_label.set_label(message)

    def _note_header(self, message):
        if getattr(self, "head", None) is not None:
            self.head.set_label(message)

    # --------------------------------------------- grab the whole window
    def grab_all(self):
        """Select everything in the window we came from and reload with it.

        Ctrl+A then Ctrl+Insert - deliberately NOT Ctrl+C, because in a
        terminal Ctrl+C sends SIGINT and would interrupt whatever is running
        there. Ctrl+Insert means copy in GTK, Qt, browsers and VTE alike,
        and is harmless everywhere else.

        It does overwrite the clipboard, which is the price of reading the
        text at all - there is no way to ask another window for its
        contents on Wayland.
        """
        if not YDOTOOL:
            self._note_header("ydotool is not installed")
            return
        self._busy = True
        self._drop_result()
        self.set_visible(False)
        GLib.timeout_add(280, self._grab_select)

    def _grab_select(self):
        self._send_keys(_K_CTRL, _K_A)
        GLib.timeout_add(140, self._grab_copy)
        return False

    def _grab_copy(self):
        self._send_keys(_K_CTRL, _K_INS)
        GLib.timeout_add(280, self._grab_done)
        return False

    def _grab_done(self):
        grabbed = clipboard_text().strip()
        self._busy = False
        if grabbed:
            # Get out of the way. The selection is live in the other window
            # and on the clipboard, so pressing the key again acts on all
            # of it - no need to reappear in between.
            self._done = True
            self.close()
            return False
        # Only come back if it did not work, to say so.
        self.set_visible(True)
        self.present()
        self._note_header("Nothing came back — that window may not "
                          "do select-all.")
        return False

    def _matches(self, row):
        if row.is_result:
            return True
        q = self.filter.get_text().strip().lower()
        return q in row.label_text.lower() if q else True

    def _activate_first(self, *_):
        i = 0
        while (row := self.list.get_row_at_index(i)) is not None:
            if row.fn is not None and self._matches(row):
                self._chosen(self.list, row)
                return
            i += 1

    # -- results, inline
    def _drop_result(self):
        if self._result_row is not None:
            self.list.remove(self._result_row)
            self._result_row = None

    def _chosen(self, _list, row):
        if row.is_result or row.fn is None:
            return
        self._drop_result()
        self._busy = True
        try:
            body = row.fn(self.text)
        except Exception as e:
            body = f"{row.label_text} failed:\n\n{e}"
        finally:
            self._busy = False
        if body is None:
            self._done = True
            self.close()
            return
        # Only the maths output needs a fixed-width font; it is what keeps
        # the fraction bars and the = column lined up. Prose in monospace
        # just renders IPA and accents badly.
        self._show_result(row.get_index(), body, mono=row.fn in _MONO_ACTIONS)

    def _show_result(self, index, body, mono=False):
        holder = Gtk.ListBoxRow(activatable=False, selectable=False)
        holder.is_result = True
        holder.fn = holder.label_text = None

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                      margin_top=2, margin_bottom=12,
                      margin_start=12, margin_end=12)

        if isinstance(body, Panel):
            # The action builds its own widget - a dropdown, a live label -
            # and fills in its text later, so Copy has to ask it each time
            # rather than capture a string now.
            widget = body.build(self)
            widget.add_css_class("qm-text")
            box.append(widget)
            get_text = body.current_text
            self._result_label = body.label_widget()
        else:
            label = Gtk.Label(label=body, selectable=True, wrap=True,
                              xalign=0.0, halign=Gtk.Align.START,
                              # 70 only so a 64-character sha256 fits
                              # on one line; shorter results never
                              # widen the window at all.
                              max_width_chars=70 if mono else 46)
            # A 128-character hex digest is one unbreakable word, so plain
            # word wrapping cannot split it and the label demands its full
            # width - which stretched the window past 1000px. WORD_CHAR
            # lets it break inside the token. Short lines, including the
            # 2-D maths blocks, never reach the limit so stay untouched.
            label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            label.add_css_class("qm-mono" if mono else "qm-text")
            box.append(label)
            get_text = lambda: body               # noqa: E731
            self._result_label = label
            self._last_result = body
            set_clipboard(body)         # usually the next step is pasting it

        self._get_text = get_text
        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                          halign=Gtk.Align.START)
        copy_btn = Gtk.Button(label="Copy")
        copy_btn.connect(
            "clicked", lambda *_: self._copy_feedback(copy_btn,
                                                      self._pick_text()))
        buttons.append(copy_btn)
        if YDOTOOL:
            rep = Gtk.Button(label="Replace selection")
            rep.set_tooltip_text(
                "Paste this over the text you highlighted   (Ctrl+Enter)")
            rep.connect("clicked",
                        lambda *_: self.replace_selection(self._pick_text()))
            buttons.append(rep)
        box.append(buttons)

        holder.set_child(box)
        self.list.insert(holder, index + 1)
        self._result_row = holder

    def note_text(self, text):
        """A panel reporting the text it now holds, so Esc does not lose it."""
        if text:
            self._last_result = text
            set_clipboard(text)

    def _copy_feedback(self, btn, body):
        set_clipboard(body)
        self._last_result = body
        btn.set_label("Copied")
        GLib.timeout_add_seconds(
            2, lambda: (btn.set_label("Copy"), False)[1])


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.sebastian.qm")

    def do_startup(self):
        Gtk.Application.do_startup(self)
        css = Gtk.CssProvider()
        css.load_from_data(_CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        """Open the menu, or dismiss it if it is already up.

        Every press launches a fresh process; GtkApplication turns that into
        a toggle for free, because a second process with the same
        application_id hands its activation to the running one and exits.
        Closing the last window quits, so the next press re-reads the
        selection - which is what you want, it has probably changed.
        """
        if self.get_windows():
            for w in list(self.get_windows()):
                w.close()
            return
        Menu(self, selection()).present()


if __name__ == "__main__":
    sys.exit(App().run([]))
